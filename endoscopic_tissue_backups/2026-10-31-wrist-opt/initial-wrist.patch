+// Use the finite-segment solution for a non-cutting wrist only where the
+// closest-point geometry is well conditioned. Keep the existing witness for
+// degenerate/parallel configurations and undefined normals near the capsule axis.
+__device__ inline float3 wristTriangleWitness(ContactShape shape,const float3* q){
+    float3 a=q[1]-q[0],b=q[2]-q[0],axis=shape.b-shape.a,normal=cross3(a,b);
+    float axis2=dot3(axis,axis),area2=dot3(normal,normal);
+    float edge2=fmaxf(dot3(a,a),fmaxf(dot3(b,b),dot3(b-a,b-a))),projection=dot3(axis,normal);
+    if(!(axis2>1e-20f && area2>1e-6f*edge2*edge2) ||
+       projection*projection<=1e-8f*axis2*area2)
+        return triangleWitness(shape,q[0],q[1],q[2]);
+    float3 bary=bladeTriangleWitness(shape,q),n,s;
+    if(!isfinite(bary.x) || !isfinite(bary.y) || !isfinite(bary.z) ||
+       bary.x<0 || bary.y<0 || bary.z<0 || fabsf(bary.x+bary.y+bary.z-1)>1e-4f)
+        return triangleWitness(shape,q[0],q[1],q[2]);
+    float distance=shapeDistance(shape,q[0]*bary.x+q[1]*bary.y+q[2]*bary.z,n,s);
+    if(!isfinite(distance) || distance<=-shape.radius+fmaxf(1e-6f,1e-4f*shape.radius))
+        return triangleWitness(shape,q[0],q[1],q[2]);
+    return bary;
+}
