+    ids0=np.empty(counts[0],np.int32);ids1=np.empty(counts[1],np.int32)
+    bounds=np.empty((2,2,3),np.float32)
+    for part in range(2):
+        bounds[part,0,:]=np.inf;bounds[part,1,:]=-np.inf
+    offsets=np.zeros(2,np.int32)
+    for t in range(n//3):
