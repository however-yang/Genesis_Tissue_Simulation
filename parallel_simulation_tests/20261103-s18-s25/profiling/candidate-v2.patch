+    def read(self,scene,flags):
+        from genesis.ext.pyrender.constants import RenderFlags
+        if not self.active or flags & (RenderFlags.SEG|RenderFlags.DEPTH_ONLY|RenderFlags.RGBA):
+            return self.original(scene,flags)
