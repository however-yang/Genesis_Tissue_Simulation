+        enabled={cap:bool(gl.glIsEnabled(cap)) for cap in caps};textures=[]
+        for i in range(4):
+            gl.glActiveTexture(gl.GL_TEXTURE0+i);textures.append(int(gl.glGetIntegerv(gl.GL_TEXTURE_BINDING_2D)))
